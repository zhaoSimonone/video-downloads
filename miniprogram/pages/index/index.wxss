.page{min-height:100vh;background:#f3f4f1;color:#171a1d}.topbar{display:flex;align-items:center;justify-content:space-between;padding:24rpx 34rpx 20rpx;background:#12161a;color:#f5f6f3}.brand{display:flex;align-items:center;gap:14rpx;font-size:32rpx;font-weight:800}.brand-mark{display:flex;align-items:center;justify-content:center;width:52rpx;height:52rpx;border-radius:12rpx;background:#e6462f;color:#fff;font-size:28rpx}.beta{font-size:17rpx;letter-spacing:1rpx;color:#7f8989}.local-pill{display:flex;align-items:center;gap:10rpx;color:#aeb7b4;font-size:20rpx}.dot{width:12rpx;height:12rpx;border-radius:50%;background:#49c794;box-shadow:0 0 0 6rpx #24443b}.scroll{height:calc(100vh - 96rpx);padding:0 30rpx}.hero{padding:58rpx 4rpx 30rpx}.eyebrow{color:#e6462f;font-family:"DM Mono",monospace;font-size:19rpx;letter-spacing:3rpx;font-weight:500}.title{margin-top:16rpx;font-size:54rpx;letter-spacing:-3rpx;font-weight:900}.subtitle{margin-top:14rpx;color:#7b8481;font-size:24rpx}.card{margin-bottom:24rpx;border:1rpx solid #e0e5e1;border-radius:14rpx;background:#fff}.input-card{padding:32rpx 28rpx 24rpx}.section-head{display:flex;align-items:flex-start;justify-content:space-between}.section-title{font-size:32rpx;font-weight:800}.section-sub{margin-top:8rpx;color:#929c98;font-size:21rpx}.secure{padding:10rpx 13rpx;border-radius:6rpx;background:#e7f5ef;color:#38836b;font-family:"DM Mono",monospace;font-size:18rpx}.tabs{display:flex;gap:14rpx;margin:34rpx 0 26rpx;border-bottom:1rpx solid #e7ebe8}.tab{display:flex;align-items:center;gap:11rpx;padding:0 4rpx 18rpx;border:0;border-bottom:4rpx solid transparent;background:transparent;color:#9ba39f;font-size:23rpx;font-weight:700}.tab.active{border-color:#e6462f;color:#171a1d}.logo{display:flex;align-items:center;justify-content:center;width:38rpx;height:38rpx;border-radius:8rpx;color:#fff;font-size:26rpx}.douyin{background:#111}.channels{background:#29a97a;font-size:19rpx}.field-label{margin-bottom:11rpx;color:#78817e;font-family:"DM Mono",monospace;font-size:18rpx;letter-spacing:2rpx}.input-wrap{position:relative}.url-input{height:88rpx;padding:0 74rpx 0 72rpx;border:1rpx solid #d8dfda;border-radius:10rpx;background:#fbfcfa;font-family:"DM Mono",monospace;font-size:21rpx}.link-symbol{position:absolute;z-index:1;left:24rpx;top:26rpx;color:#aab3af;font-size:26rpx}.clear{position:absolute;right:8rpx;top:11rpx;padding:8rpx 14rpx;border:0;background:transparent;color:#9ca6a2;font-size:34rpx}.input-meta{display:flex;align-items:center;justify-content:space-between;margin-top:10rpx;color:#9ea7a3;font-size:18rpx}.primary{height:84rpx;margin-top:24rpx;border-radius:9rpx;background:#e6462f;color:#fff;font-size:25rpx;font-weight:800;line-height:84rpx}.primary.loading{opacity:.75}.example{margin-top:21rpx;padding:0;border:0;background:transparent;color:#67716d;font-size:20rpx;text-align:left}.result-card{padding:30rpx 28rpx}.result-head{display:flex;justify-content:space-between;align-items:flex-start}.result-title{margin-top:11rpx;font-size:29rpx;font-weight:800}.platform-chip{padding:10rpx 13rpx;border-radius:6rpx;background:#e7f4ef;color:#39816f;font-family:"DM Mono",monospace;font-size:18rpx}.preview{display:grid;grid-template-columns:210rpx 1fr;gap:22rpx;margin-top:28rpx}.preview-art{height:228rpx;border-radius:9rpx;background:linear-gradient(145deg,#262c31,#765650 54%,#d8aba0);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden}.preview-art:before{content:"";position:absolute;right:-54rpx;bottom:-70rpx;width:180rpx;height:230rpx;border-radius:80% 40% 30% 60%;background:#d9ada1;opacity:.8}.play{position:relative;display:flex;align-items:center;justify-content:center;width:65rpx;height:65rpx;border:2rpx solid #fff;border-radius:50%;color:#fff;font-size:22rpx;padding-left:5rpx}.preview-label{position:absolute;left:14rpx;bottom:12rpx;color:#fffe;font-family:"DM Mono",monospace;font-size:16rpx;letter-spacing:2rpx}.details{display:flex;flex-direction:column;gap:16rpx}.detail{display:flex;align-items:center;justify-content:space-between;gap:10rpx;padding-bottom:13rpx;border-bottom:1rpx solid #eff1ef;color:#9ba39f;font-size:19rpx}.value{max-width:67%;overflow:hidden;color:#3e4745;font-weight:600;text-align:right;text-overflow:ellipsis;white-space:nowrap}.source{font-family:"DM Mono",monospace;font-size:16rpx}.notice{display:flex;gap:13rpx;margin-top:23rpx;padding:16rpx;border-radius:8rpx;background:#fff5e8;color:#8a6333;font-size:19rpx;line-height:1.5}.info{display:flex;flex:none;align-items:center;justify-content:center;width:28rpx;height:28rpx;border:2rpx solid #c99855;border-radius:50%;font-family:"DM Mono",monospace;font-size:17rpx}.open-link{margin-top:8rpx;padding:0;border:0;background:transparent;color:#9b672b;font-size:19rpx;text-align:left}.download-row{display:flex;align-items:flex-end;justify-content:space-between;gap:14rpx;margin-top:26rpx;padding-top:22rpx;border-top:1rpx solid #eef0ee}.quality{height:70rpx;padding:0 18rpx;border:1rpx solid #d9dfdb;border-radius:8rpx;color:#4e5754;font-family:"DM Mono",monospace;font-size:19rpx;line-height:70rpx}.download{height:70rpx;min-width:220rpx;border-radius:8rpx;background:#e6462f;color:#fff;font-size:22rpx;font-weight:800;line-height:70rpx}.download.disabled{background:#cdd4d0}.empty-card{padding:100rpx 30rpx;text-align:center}.empty-icon{color:#c0c8c3;font-size:70rpx;font-weight:300}.empty-title{margin-top:18rpx;font-size:29rpx;font-weight:800}.empty-sub{margin-top:10rpx;color:#9ba4a0;font-size:20rpx}.legal{padding:8rpx 0 34rpx;color:#a2aaa6;font-size:17rpx;text-align:center}@media (max-width:700px){.scroll{padding:0 24rpx}.title{font-size:47rpx}.preview{grid-template-columns:190rpx 1fr}.download{min-width:190rpx}}
